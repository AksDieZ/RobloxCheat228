-- Water Color
local waterParts = {}
local map = workspace:FindFirstChild("Map")
if map then
    local alwaysHere = map:FindFirstChild("AlwaysHereTweenedObjects")
    if alwaysHere then
        local objectModel = alwaysHere:FindFirstChild("ObjectModel")
        if objectModel then
            for _, obj in pairs(objectModel:GetChildren()) do
                if obj.Name == "Ocean" and obj:IsA("BasePart") then
                    table.insert(waterParts, obj)
                end
            end
        end
        if #waterParts == 0 then
            for _, obj in pairs(alwaysHere:GetDescendants()) do
                if obj.Name == "Ocean" and obj:IsA("BasePart") then
                    table.insert(waterParts, obj)
                end
            end
        end
    end
end

if #waterParts > 0 then
    VisualTab:CreateColorPicker({
        Name = "Water Color",
        Color = Color3.fromRGB(8, 137, 207),
        Flag = "WaterColor",
        Callback = function(Color)
            for _, part in pairs(waterParts) do
                part.Color = Color
            end
        end
    })
else
    VisualTab:CreateParagraph({
        Title = "Water Color",
        Content = "❌ Water not found in this game"
    })
end

