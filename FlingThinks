-- ESP
local espActive = false
local espFolder = nil
local renderConn = nil
local espColor = Color3.fromRGB(255, 255, 255)

local function destroyESP()
    if espFolder then espFolder:Destroy() end
    for _, plr in pairs(Players:GetPlayers()) do
        if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local esp = plr.Character.HumanoidRootPart:FindFirstChild(plr.Name .. "_ESP")
            if esp then esp:Destroy() end
        end
    end
end

local function createESP()
    destroyESP()
    espFolder = Instance.new("Folder")
    espFolder.Name = "ESP_Folder"
    espFolder.Parent = game:GetService("CoreGui")
    
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local bill = Instance.new("BillboardGui")
            bill.Name = plr.Name .. "_ESP"
            bill.Size = UDim2.new(0, 130, 0, 32)
            bill.StudsOffset = Vector3.new(0, 2.2, 0)
            bill.AlwaysOnTop = true
            bill.Parent = plr.Character.HumanoidRootPart
            
            local nameLabel = Instance.new("TextLabel")
            nameLabel.Size = UDim2.new(1, 0, 1, 0)
            nameLabel.BackgroundTransparency = 1
            nameLabel.Text = plr.Name
            nameLabel.Font = Enum.Font.GothamBold
            nameLabel.TextSize = 13
            nameLabel.TextStrokeTransparency = 0.3
            nameLabel.TextColor3 = espColor
            nameLabel.Parent = bill
        end
    end
end

local function updateESP()
    if not espActive then return end
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local bill = plr.Character.HumanoidRootPart:FindFirstChild(plr.Name .. "_ESP")
            if not bill then
                local newBill = Instance.new("BillboardGui")
                newBill.Name = plr.Name .. "_ESP"
                newBill.Size = UDim2.new(0, 130, 0, 32)
                newBill.StudsOffset = Vector3.new(0, 2.2, 0)
                newBill.AlwaysOnTop = true
                newBill.Parent = plr.Character.HumanoidRootPart
                
                local nameLabel = Instance.new("TextLabel")
                nameLabel.Size = UDim2.new(1, 0, 1, 0)
                nameLabel.BackgroundTransparency = 1
                nameLabel.Text = plr.Name
                nameLabel.Font = Enum.Font.GothamBold
                nameLabel.TextSize = 13
                nameLabel.TextStrokeTransparency = 0.3
                nameLabel.TextColor3 = espColor
                nameLabel.Parent = newBill
            else
                local nameLabel = bill:FindFirstChildWhichIsA("TextLabel")
                if nameLabel then
                    nameLabel.TextColor3 = espColor
                end
            end
        end
    end
end

VisualTab:CreateToggle({
    Name = "ESP",
    CurrentValue = false,
    Flag = "ESPToggle",
    Callback = function(Value)
        espActive = Value
        if espActive then
            createESP()
            if renderConn then renderConn:Disconnect() end
            renderConn = RunService.RenderStepped:Connect(function()
                if espActive then updateESP() end
            end)
            Rayfield:Notify({Title = "VISUAL", Content = "ESP Enabled", Duration = 2})
        else
