-- Further Reach
local frActive = false
local diedHandle = nil
local ScriptNotify = ReplicatedStorage.GamepassEvents.FurtherReachBoughtNotifier
local Activator = ReplicatedStorage.MenuToys.LimitedTimeToyEvent

local function ReloadScript()
    if LocalPlayer.Character then
        local grab = LocalPlayer.Character:FindFirstChild("GrabbingScript")
        if grab then
            grab.Enabled = false
            grab.Enabled = true
        end
    end
end

local function disableFR()
    local val = LocalPlayer:FindFirstChild("FartherReach")
    if val then val:Destroy() end
    pcall(function() hookinstance(ScriptNotify, ScriptNotify) end)
    ReloadScript()
end

local function enableFR()
    disableFR()
    task.wait(0.1)
    local newVal = Instance.new("BoolValue")
    newVal.Name = "FartherReach"
    newVal.Value = true
    newVal.Parent = LocalPlayer
    pcall(function() hookinstance(ScriptNotify, Activator) end)
    ReloadScript()
    task.delay(0.1, function()
        pcall(function() Activator:FireServer() end)
    end)
end

local function reapplyFR()
    if frActive then
        pcall(function()
            local val = LocalPlayer:FindFirstChild("FartherReach")
            if not val or not val.Value then
                enableFR()
            else
                hookinstance(ScriptNotify, Activator)
                Activator:FireServer()
                ReloadScript()
            end
        end)
    end
end

local function onCharacterAdded(character)
    character:WaitForChild("GrabbingScript", 5)
    task.wait(0.5)
    reapplyFR()
end

PvpTab:CreateToggle({
    Name = "Further Reach",
    CurrentValue = false,
    Flag = "FRToggle",
    Callback = function(Value)
        frActive = Value
        if frActive then
            enableFR()
            if diedHandle then diedHandle:Disconnect() end
            diedHandle = LocalPlayer.CharacterAdded:Connect(onCharacterAdded)
        else
            disableFR()
            if diedHandle then
                diedHandle:Disconnect()
                diedHandle = nil
            end
        end
    end
})

-- Auto Aim
local aimActive = false
local aimConn = nil
local aimKey = "Q"

local function getClosestPlayer()
    local closest = nil
    local shortest = math.huge
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local dist = (plr.Character.HumanoidRootPart.Position - (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character.HumanoidRootPart.Position or Vector3.new())).magnitude
            if dist < shortest then
                closest = plr
                shortest = dist
            end
        end
    end
    return closest
end

