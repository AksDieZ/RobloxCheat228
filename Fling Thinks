-- Auto Aim functions
local function getClosestNonFriend()
    local closest = nil
    local shortest = math.huge
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            if not isPlayerFriend(plr) then
                local dist = (plr.Character.HumanoidRootPart.Position - (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character.HumanoidRootPart.Position or Vector3.new())).magnitude
                if dist < shortest then
                    closest = plr
                    shortest = dist
                end
            end
        end
    end
    return closest
end

local function setupAutoAim()
    if aimConn then aimConn:Disconnect() end
    if aimActive then
        aimConn = UIS.InputBegan:Connect(function(input, processed)
            if aimActive and input.KeyCode == aimKeyCode and not processed then
                local target = getClosestNonFriend()
                if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Character.HumanoidRootPart.Position)
                    mouse1click()
                end
            end
        end)
    end
end

