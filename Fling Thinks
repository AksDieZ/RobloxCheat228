local function ReloadScript()
    if LocalPlayer.Character then
        local grab = LocalPlayer.Character:FindFirstChild("GrabbingScript")
        if grab then
            grab.Enabled = false
            grab.Enabled = true
        end
    end
end

local function disableFR()
    local val = LocalPlayer:FindFirstChild("FartherReach")
    if val then val:Destroy() end
    pcall(function()
        hookinstance(ScriptNotify, ScriptNotify)
    end)
    ReloadScript()
end

local function enableFR()
    local val = LocalPlayer:FindFirstChild("FartherReach")
    if val then val:Destroy() end
    
    local newVal = Instance.new("BoolValue")
    newVal.Name = "FartherReach"
    newVal.Value = true
    newVal.Parent = LocalPlayer
    
    pcall(function()
        hookinstance(ScriptNotify, Activator)
    end)
    ReloadScript()
    
    task.delay(0.1, function()
        pcall(function()
            Activator:FireServer()
        end)
    end)
end

local function reapplyFR()
    if frActive then
        pcall(function()
            local val = LocalPlayer:FindFirstChild("FartherReach")
            if not val or not val.Value then
                enableFR()
            else
                hookinstance(ScriptNotify, Activator)
                Activator:FireServer()
                ReloadScript()
            end
        end)
    end
end

local function onCharacterAdded(character)
    character:WaitForChild("GrabbingScript", 5)
    task.wait(0.5)
    reapplyFR()
end

