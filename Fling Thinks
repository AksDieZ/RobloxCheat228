-- Player List Window
local playerWindow = nil
local targetList = {}
local friendList = {}

local function isPlayerTargeted(plr)
    for _, targeted in pairs(targetList) do
        if targeted == plr then return true end
    end
    return false
end

local function isPlayerFriend(plr)
    for _, friend in pairs(friendList) do
        if friend == plr then return true end
    end
    return false
end

local function removeFromTarget(plr)
    for i, targeted in pairs(targetList) do
        if targeted == plr then
            table.remove(targetList, i)
            break
        end
    end
end

local function removeFromFriend(plr)
    for i, friend in pairs(friendList) do
        if friend == plr then
            table.remove(friendList, i)
            break
        end
    end
end

local function addToTarget(plr)
    removeFromFriend(plr)
    if not isPlayerTargeted(plr) then
        table.insert(targetList, plr)
    end
end

local function addToFriend(plr)
    removeFromTarget(plr)
    if not isPlayerFriend(plr) then
        table.insert(friendList, plr)
    end
end

